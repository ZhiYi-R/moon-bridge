{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moon Bridge",
  "version": "0.1.0",
  "identifier": "com.moonbridge.desktop",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Moon Bridge",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/moonbridge"],
    "category": "DeveloperTool",
    "shortDescription": "Moon Bridge desktop console",
    "longDescription": "Desktop shell for Moon Bridge: local Go proxy sidecar plus Bauhaus Web Console."
  }
}
